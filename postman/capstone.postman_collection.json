            "url": {
              "raw": "{{baseUrl}}/cards/{{cardId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cards",
                "{{cardId}}",
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"SELL\",\n  \"quantity\": 1,\n  \"unitPrice\": 400.0,\n  \"date\": \"2026-10-10\",\n  \"counterparty\": \"Mario\",\n  \"platform\": \"fiera\",\n  \"notes\": null\n}"
            },
            "auth": {
