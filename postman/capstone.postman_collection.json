                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"BUY\",\n  \"quantity\": 2,\n  \"unitPrice\": 250.0,\n  \"date\": \"2026-10-01\",\n  \"counterparty\": null,\n  \"platform\": \"Cardmarket\",\n  \"notes\": null\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Registra vendita",
          "request": {
