# Copia in .env e compila. .env NON va committato (e' nel .gitignore).
DB_URL=jdbc:postgresql://localhost:5432/cardvault
DB_USERNAME=postgres
DB_PASSWORD=

# Almeno 32 caratteri casuali (es. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (console.cloudinary.com > Settings > API Keys). Senza queste l'upload foto non è disponibile
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
